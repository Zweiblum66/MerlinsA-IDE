{
  "name": "@the-ide/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "the-ide": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@the-ide/core": "workspace:*",
    "@the-ide/db": "workspace:*",
    "@the-ide/scrum": "workspace:*",
    "@the-ide/wizard": "workspace:*",
    "@the-ide/token-optimizer": "workspace:*",
    "@the-ide/api-registry": "workspace:*",
    "@the-ide/naming": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "drizzle-orm": "^0.35.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@types/uuid": "^10.0.0"
  }
}
