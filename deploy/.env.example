# MerlinsA-IDE API Server Configuration
# Copy to .env and update values for your environment

# Server
THE_IDE_PORT=3000
THE_IDE_HOST=127.0.0.1

# Database
THE_IDE_DB_PATH=./data/the-ide.db

# Authentication
THE_IDE_JWT_SECRET=change-me-to-a-random-32-char-secret
THE_IDE_AUTH_USERNAME=admin
THE_IDE_AUTH_PASSWORD=change-me-to-a-strong-password

# CORS (comma-separated origins)
THE_IDE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Project ID (used for API contract auto-registration)
THE_IDE_PROJECT_ID=default
